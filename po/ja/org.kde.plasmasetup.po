#: src/initialstartutil.cpp:33
#, kde-format
msgctxt "%1 is the distro name"
msgid "Your device is now ready.<br /><br />Enjoy <b>%1</b>!"
msgstr ""
"お使いのデバイスの準備が整いました。<br /><br /><b>%1</b> オペレーティングシ"
"ステムへようこそ！"

#: src/initialstartutil.cpp:38
#, kde-format
msgctxt "%1 is the distro name"
msgid ""
"Your device is now ready.<br /><br />After clicking <b>Finish</b> you will "
"be able to sign in to your new account.<br /><br />Enjoy <b>%1</b>!"
msgstr ""
"お使いのデバイスは準備完了です。<br /><br /><b>完了</b> をクリックすると、新"
"しいアカウントにサインインできます。<br /><br /><b>%1</b> オペレーティングシ"
"ステムへようこそ！"

